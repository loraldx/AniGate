[Unit]
Description=AniGate legacy Max local MCP gateway
After=network-online.target

[Service]
Type=simple
# 8789 keeps the legacy Max alias off 8787 (Mini) and 8788 (Max), so all
# three services can be enabled side by side.
ExecStart=%h/.local/bin/anigate http --addr 127.0.0.1:8789 --config %h/.config/anigate/anigate.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Add operator or agent workspace directories here if your config needs writes.
ReadWritePaths=%h/.local/state/anigate %h/.config/anigate

[Install]
WantedBy=default.target
